#!/usr/bin/make -f
# Copyright (C) 2026 Intel Corporation
#
# SPDX-License-Identifier: Apache-2.0

export ROS_DISTRO := jazzy
export DH_VERBOSE := 1
# As in bloom-generated rules: do not inherit Ubuntu's default linker flags.
export LDFLAGS :=

ROS_PREFIX := /opt/ros/$(ROS_DISTRO)
PACKAGE := $(shell dh_listpackages)
# setup.sh exports the CMake, ament and library paths of the ROS installation.
ROS_ENV := . $(ROS_PREFIX)/setup.sh

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	$(ROS_ENV) && dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=$(ROS_PREFIX) \
		-DAMENT_PREFIX_PATH=$(ROS_PREFIX) \
		-DCMAKE_PREFIX_PATH=$(ROS_PREFIX) \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF

override_dh_auto_build:
	$(ROS_ENV) && dh_auto_build

override_dh_auto_install:
	$(ROS_ENV) && dh_auto_install

# The tests need OpenVINO models; they run through `make test`.
override_dh_auto_test:

override_dh_shlibdeps:
	$(ROS_ENV) && dh_shlibdeps -l$(CURDIR)/debian/$(PACKAGE)$(ROS_PREFIX)/lib
